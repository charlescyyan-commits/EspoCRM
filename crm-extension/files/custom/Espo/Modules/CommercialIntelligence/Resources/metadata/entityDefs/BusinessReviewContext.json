{
  "fields": {
    "name": {
      "type": "varchar",
      "maxLength": 255,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "status": {
      "type": "enum",
      "required": true,
      "default": "OPEN",
      "options": [
        "OPEN",
        "CLOSED"
      ],
      "readOnly": true,
      "displayAsLabel": true
    },
    "commercialBriefReferences": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "commercialInsightReferences": {
      "type": "text",
      "readOnly": true
    },
    "opportunityCandidateReference": {
      "type": "varchar",
      "maxLength": 64,
      "readOnly": true
    },
    "revenueInsightReference": {
      "type": "varchar",
      "maxLength": 64,
      "readOnly": true
    },
    "pipelineMetricReference": {
      "type": "varchar",
      "maxLength": 64,
      "readOnly": true
    },
    "aggregationSnapshot": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "capabilityReference": {
      "type": "varchar",
      "maxLength": 64,
      "required": true,
      "default": "COMMERCIAL_BRIEF",
      "readOnly": true
    },
    "purposeReference": {
      "type": "varchar",
      "maxLength": 64,
      "required": true,
      "default": "commercial_insight_advisory",
      "readOnly": true
    },
    "closedBy": {
      "type": "varchar",
      "maxLength": 100,
      "readOnly": true
    },
    "closedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    }
  },
  "links": {
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "status"
    ]
  },
  "deleteId": true,
  "indexes": {
    "status": {
      "columns": [
        "status"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    }
  }
}
