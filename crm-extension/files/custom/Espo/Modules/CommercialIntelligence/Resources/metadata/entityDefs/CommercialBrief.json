{
  "fields": {
    "opportunityCandidate": {
      "type": "link",
      "required": true,
      "readOnly": true
    },
    "reportingPeriod": {
      "type": "varchar",
      "maxLength": 128,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "generatedAt": {
      "type": "datetime",
      "required": true,
      "readOnly": true
    },
    "generationVersion": {
      "type": "varchar",
      "maxLength": 64,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "customerSituation": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "commercialSignals": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "riskFactors": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "suggestedReviewPoints": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "sourceEvidence": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "evidenceSetHash": {
      "type": "varchar",
      "maxLength": 64,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "claimSourceMap": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "sourceAIJob": {
      "type": "link",
      "required": true,
      "readOnly": true
    },
    "sourceAIRequestLog": {
      "type": "link",
      "required": true,
      "readOnly": true
    },
    "provider": {
      "type": "varchar",
      "maxLength": 128,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "model": {
      "type": "varchar",
      "maxLength": 128,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "promptTemplateId": {
      "type": "varchar",
      "maxLength": 128,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "promptTemplateVersion": {
      "type": "varchar",
      "maxLength": 64,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "capability": {
      "type": "varchar",
      "maxLength": 64,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "purpose": {
      "type": "varchar",
      "maxLength": 64,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "advisoryDesignation": {
      "type": "varchar",
      "maxLength": 255,
      "required": true,
      "default": "AI-generated commercial summary — for human review only. Not a forecast, commitment, or decision.",
      "readOnly": true
    },
    "legalDesignation": {
      "type": "varchar",
      "maxLength": 128,
      "required": true,
      "default": "AI-GENERATED_ADVISORY_PROJECTION_NOT_A_COMMERCIAL_DECISION",
      "readOnly": true
    },
    "reviewStatus": {
      "type": "enum",
      "required": true,
      "default": "GENERATED",
      "options": [
        "GENERATED",
        "REVIEWED",
        "ACCEPTED",
        "DISMISSED"
      ],
      "readOnly": true,
      "displayAsLabel": true
    },
    "acceptanceScope": {
      "type": "enum",
      "options": [
        "",
        "DECISION_SUPPORT_MATERIAL_ONLY"
      ],
      "readOnly": true
    },
    "outcomeReason": {
      "type": "text",
      "readOnly": true
    },
    "validityDisposition": {
      "type": "enum",
      "required": true,
      "default": "NONE",
      "options": [
        "NONE",
        "INVALIDATED"
      ],
      "readOnly": true,
      "displayAsLabel": true
    },
    "retentionDisposition": {
      "type": "enum",
      "required": true,
      "default": "ACTIVE",
      "options": [
        "ACTIVE",
        "ARCHIVED"
      ],
      "readOnly": true,
      "displayAsLabel": true
    },
    "supersedesBrief": {
      "type": "link",
      "readOnly": true
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "links": {
    "opportunityCandidate": {
      "type": "belongsTo",
      "entity": "OpportunityCandidate"
    },
    "sourceAIJob": {
      "type": "belongsTo",
      "entity": "AIJob"
    },
    "sourceAIRequestLog": {
      "type": "belongsTo",
      "entity": "AIRequestLog"
    },
    "supersedesBrief": {
      "type": "belongsTo",
      "entity": "CommercialBrief"
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    }
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": [
      "reviewStatus",
      "capability",
      "purpose"
    ]
  },
  "deleteId": true,
  "indexes": {
    "reviewStatus": {
      "columns": [
        "reviewStatus"
      ]
    },
    "validityDisposition": {
      "columns": [
        "validityDisposition"
      ]
    },
    "retentionDisposition": {
      "columns": [
        "retentionDisposition"
      ]
    },
    "opportunityCandidate": {
      "columns": [
        "opportunityCandidateId"
      ]
    },
    "createdAt": {
      "columns": [
        "createdAt"
      ]
    },
    "evidenceSetHash": {
      "columns": [
        "evidenceSetHash"
      ]
    }
  }
}
