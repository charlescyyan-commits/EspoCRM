{
  "fields": {
    "name": {
      "type": "varchar",
      "maxLength": 255,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "metricType": {
      "type": "varchar",
      "maxLength": 100,
      "required": true,
      "trim": true,
      "readOnly": true
    },
    "metricValue": {
      "type": "float",
      "required": true,
      "readOnly": true
    },
    "aggregationPeriod": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "sampleSize": {
      "type": "int",
      "required": true,
      "min": 1,
      "readOnly": true
    },
    "confidenceLevel": {
      "type": "float",
      "required": true,
      "min": 0,
      "max": 1,
      "readOnly": true
    },
    "freshnessStatus": {
      "type": "enum",
      "required": true,
      "options": [
        "CURRENT",
        "AGING",
        "STALE",
        "ARCHIVAL"
      ],
      "readOnly": true,
      "displayAsLabel": true
    },
    "sourceReference": {
      "type": "text",
      "required": true,
      "readOnly": true
    },
    "generatedAt": {
      "type": "datetime",
      "required": true,
      "readOnly": true
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    }
  },
  "collection": {
    "orderBy": "generatedAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "metricType",
      "freshnessStatus"
    ]
  },
  "deleteId": true,
  "indexes": {
    "metricType": {
      "columns": [
        "metricType"
      ]
    },
    "generatedAt": {
      "columns": [
        "generatedAt"
      ]
    },
    "freshnessStatus": {
      "columns": [
        "freshnessStatus"
      ]
    }
  }
}
