{
  "fields": {
    "name": {
      "type": "varchar",
      "maxLength": 255,
      "required": true,
      "trim": true
    },
    "peEvidenceId": {
      "type": "varchar",
      "maxLength": 255,
      "required": false,
      "notNull": false,
      "trim": true,
      "tooltip": true
    },
    "peClaim": {
      "type": "varchar",
      "maxLength": 500,
      "required": false,
      "notNull": false,
      "trim": true
    },
    "peClaimType": {
      "type": "varchar",
      "maxLength": 100,
      "required": false,
      "notNull": false,
      "trim": true,
      "tooltip": true
    },
    "peEvidenceType": {
      "type": "varchar",
      "maxLength": 100,
      "required": false,
      "notNull": false,
      "trim": true,
      "tooltip": true
    },
    "evidenceType": {
      "type": "enum",
      "required": true,
      "options": [
        "UNKNOWN",
        "FACT",
        "OBSERVATION",
        "AI_INFERENCE"
      ],
      "default": "UNKNOWN",
      "displayAsLabel": true,
      "style": {
        "UNKNOWN": "warning",
        "FACT": "success",
        "OBSERVATION": "info",
        "AI_INFERENCE": "primary"
      },
      "tooltip": true
    },
    "classificationReason": {
      "type": "enum",
      "required": true,
      "options": [
        "LEGACY_UNCLASSIFIED",
        "LEGACY_MANUAL_REVIEW",
        "EXPLICIT_CREATE",
        "EXPLICIT_CORRECTION"
      ],
      "default": "LEGACY_UNCLASSIFIED",
      "readOnly": true,
      "displayAsLabel": true,
      "tooltip": true
    },
    "validationState": {
      "type": "enum",
      "required": true,
      "options": [
        "UNVALIDATED",
        "VERIFIED",
        "REJECTED",
        "SUPERSEDED"
      ],
      "default": "UNVALIDATED",
      "readOnly": true,
      "displayAsLabel": true,
      "style": {
        "UNVALIDATED": "warning",
        "VERIFIED": "success",
        "REJECTED": "danger",
        "SUPERSEDED": "default"
      },
      "tooltip": true
    },
    "peSourceUrl": {
      "type": "url",
      "required": false,
      "notNull": false
    },
    "peEvidenceText": {
      "type": "text",
      "required": false,
      "notNull": false,
      "tooltip": true
    },
    "peContentSummary": {
      "type": "text",
      "required": false,
      "notNull": false,
      "tooltip": true
    },
    "peConfidence": {
      "type": "float",
      "required": false,
      "notNull": false,
      "min": 0,
      "max": 1
    },
    "peCapturedAt": {
      "type": "datetime",
      "required": false,
      "notNull": false
    },
    "peSchemaVersion": {
      "type": "varchar",
      "maxLength": 64,
      "required": false,
      "notNull": false,
      "trim": true
    },
    "peSnapshotHash": {
      "type": "varchar",
      "maxLength": 128,
      "required": false,
      "notNull": false,
      "trim": true
    },
    "peCanonicalUrl": {
      "type": "varchar",
      "maxLength": 255,
      "required": false,
      "notNull": false,
      "trim": true,
      "utility": true
    },
    "peEvidenceTypeNormalized": {
      "type": "varchar",
      "maxLength": 100,
      "required": false,
      "notNull": false,
      "trim": true,
      "utility": true
    },
    "peClaimHash": {
      "type": "varchar",
      "maxLength": 64,
      "required": false,
      "notNull": false,
      "trim": true,
      "utility": true
    },
    "provenanceReference": {
      "type": "varchar",
      "maxLength": 255,
      "required": true,
      "default": "LEGACY_UNCLASSIFIED",
      "trim": true,
      "tooltip": true
    },
    "sourceAIRequestLog": {
      "type": "link"
    },
    "sourceAIJob": {
      "type": "link"
    },
    "supersedes": {
      "type": "link",
      "readOnly": true
    },
    "evidenceRevision": {
      "type": "int",
      "required": true,
      "default": 1,
      "min": 1,
      "readOnly": true,
      "tooltip": true
    },
    "supersededBy": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "lead": {
      "type": "link"
    },
    "prospectPool": {
      "type": "link"
    },
    "createdAt": {
      "type": "datetime",
      "readOnly": true
    },
    "modifiedAt": {
      "type": "datetime",
      "readOnly": true
    },
    "createdBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "modifiedBy": {
      "type": "link",
      "readOnly": true,
      "view": "views/fields/user"
    },
    "assignedUser": {
      "type": "link"
    },
    "teams": {
      "type": "linkMultiple"
    }
  },
  "links": {
    "lead": {
      "type": "belongsTo",
      "entity": "Lead",
      "foreign": "researchEvidences"
    },
    "prospectPool": {
      "type": "belongsTo",
      "entity": "ProspectPool",
      "foreign": "researchEvidences"
    },
    "sourceAIRequestLog": {
      "type": "belongsTo",
      "entity": "AIRequestLog"
    },
    "sourceAIJob": {
      "type": "belongsTo",
      "entity": "AIJob"
    },
    "supersedes": {
      "type": "belongsTo",
      "entity": "ResearchEvidence",
      "foreign": "supersededBy"
    },
    "supersededBy": {
      "type": "hasMany",
      "entity": "ResearchEvidence",
      "foreign": "supersedes"
    },
    "createdBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "modifiedBy": {
      "type": "belongsTo",
      "entity": "User"
    },
    "assignedUser": {
      "type": "belongsTo",
      "entity": "User"
    },
    "teams": {
      "type": "hasMany",
      "entity": "Team",
      "relationName": "entityTeam",
      "layoutRelationshipsDisabled": true
    }
  },
  "collection": {
    "orderBy": "peCapturedAt",
    "order": "desc",
    "textFilterFields": [
      "name",
      "peClaim",
      "peEvidenceId"
    ]
  },
  "deleteId": true,
  "indexes": {
    "peEvidenceId": {
      "columns": [
        "peEvidenceId"
      ]
    },
    "peSnapshotHash": {
      "columns": [
        "peSnapshotHash"
      ]
    },
    "evidenceType": {
      "columns": [
        "evidenceType"
      ]
    },
    "validationState": {
      "columns": [
        "validationState"
      ]
    },
    "sourceAIRequestLog": {
      "columns": [
        "sourceAIRequestLogId"
      ]
    },
    "sourceAIJob": {
      "columns": [
        "sourceAIJobId"
      ]
    },
    "supersedes": {
      "columns": [
        "supersedesId"
      ]
    },
    "c10EvidenceIdentity": {
      "type": "unique",
      "columns": [
        "leadId",
        "peCanonicalUrl",
        "peEvidenceTypeNormalized",
        "peClaimHash",
        "evidenceRevision",
        "deleteId"
      ]
    },
    "c10EvidenceIdentityProspectPool": {
      "type": "unique",
      "columns": [
        "prospectPoolId",
        "peCanonicalUrl",
        "peEvidenceTypeNormalized",
        "peClaimHash",
        "evidenceRevision",
        "deleteId"
      ]
    }
  }
}
