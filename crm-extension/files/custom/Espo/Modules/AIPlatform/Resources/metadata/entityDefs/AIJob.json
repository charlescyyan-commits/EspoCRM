{
  "fields": {
    "name": {"type": "varchar", "maxLength": 255, "required": true, "trim": true},
    "capability": {"type": "enum", "required": true, "options": ["SEARCH", "ENRICHMENT", "COMPLETION"], "displayAsLabel": true},
    "purpose": {"type": "varchar", "maxLength": 100, "required": true, "trim": true},
    "requestedBy": {"type": "link", "required": true, "readOnly": true},
    "policyVersion": {"type": "varchar", "maxLength": 100, "required": true, "trim": true, "readOnly": true},
    "status": {"type": "enum", "required": true, "readOnly": true, "default": "QUEUED", "options": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"], "displayAsLabel": true, "style": {"QUEUED": "default", "RUNNING": "info", "SUCCEEDED": "success", "FAILED": "danger", "CANCELLED": "warning"}},
    "attemptCount": {"type": "int", "required": true, "readOnly": true, "default": 0, "min": 0},
    "failureCategory": {"type": "enum", "required": false, "notNull": false, "readOnly": true, "options": ["NETWORK", "PROVIDER", "AUTH", "RATE_LIMIT", "VALIDATION", "UNKNOWN", "QUOTA", "CONTENT_FILTER"], "displayAsLabel": true},
    "lastError": {"type": "text", "required": false, "notNull": false, "readOnly": true},
    "nextRetryAt": {"type": "datetime", "required": false, "notNull": false, "readOnly": true},
    "startedAt": {"type": "datetime", "required": false, "notNull": false, "readOnly": true},
    "completedAt": {"type": "datetime", "required": false, "notNull": false, "readOnly": true},
    "executionMode": {"type": "enum", "required": true, "default": "LIVE", "options": ["LIVE", "DRY_RUN"], "displayAsLabel": true, "readOnly": true},
    "idempotencyKey": {"type": "varchar", "maxLength": 255, "required": true, "trim": true, "readOnly": true},
    "resultReference": {"type": "varchar", "maxLength": 255, "required": false, "notNull": false, "trim": true, "readOnly": true},
    "createdAt": {"type": "datetime", "readOnly": true}
  },
  "links": {
    "requestedBy": {"type": "belongsTo", "entity": "User"}
  },
  "collection": {
    "orderBy": "createdAt",
    "order": "desc",
    "textFilterFields": ["name", "capability", "purpose", "status", "idempotencyKey"]
  },
  "deleteId": true,
  "indexes": {
    "idempotencyKey": {"type": "unique", "columns": ["idempotencyKey", "deleteId"]}
  }
}
