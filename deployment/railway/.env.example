# Copy locally only. Never commit secrets or use this file as deployment authority.

# Replace with an approved immutable reference; a tag alone is ineligible.
ESPOCRM_BASE_IMAGE=espocrm/espocrm:10.0.1@sha256:replace-with-approved-64-hex-digest
APP_ENV=staging
ESPOCRM_STAGING=1

PORT=8080
HOST_PORT=18080
ESPOCRM_SITE_URL=http://localhost:18080

# Isolated staging database values only.
ESPOCRM_DATABASE_PLATFORM=Mysql
ESPOCRM_DATABASE_HOST=espocrm-db
ESPOCRM_DATABASE_PORT=3306
ESPOCRM_DATABASE_NAME=espocrm_staging
ESPOCRM_DATABASE_USER=espocrm_staging
ESPOCRM_DATABASE_PASSWORD=change-me-staging-db
MARIADB_ROOT_PASSWORD=change-me-staging-root

# Forbidden: provider credentials and any production opt-in.
# INSTANTLY_API_KEY=
# APOLLO_API_KEY=
# APIFY_TOKEN=
# SMTP_PASSWORD=
# BREVO_API_KEY=
# ESPOCRM_ALLOW_PRODUCTION=1
