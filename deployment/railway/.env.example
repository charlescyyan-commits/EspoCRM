# Copy to deployment/railway/.env for local compose only.
# NEVER commit real secrets. Railway sets these in the dashboard.

# --- Image ---
ESPOCRM_VERSION=10.0.1
APP_ENV=staging
ESPOCRM_STAGING=1

# --- HTTP ---
# Railway injects PORT. Local compose maps HOST_PORT -> PORT.
PORT=8080
HOST_PORT=18080
ESPOCRM_SITE_URL=http://localhost:18080

# --- Database (staging-only; isolate from production) ---
ESPOCRM_DATABASE_PLATFORM=Mysql
ESPOCRM_DATABASE_HOST=espocrm-db
ESPOCRM_DATABASE_PORT=3306
ESPOCRM_DATABASE_NAME=espocrm_staging
ESPOCRM_DATABASE_USER=espocrm_staging
ESPOCRM_DATABASE_PASSWORD=change-me-staging-db
MARIADB_ROOT_PASSWORD=change-me-staging-root

# --- Admin (first install only; change immediately after login) ---
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=change-me-staging-admin

# --- Railway MySQL plugin mapping (example) ---
# When using Railway MySQL/MariaDB plugin, map reference variables:
# ESPOCRM_DATABASE_HOST=${{MySQL.MYSQLHOST}}
# ESPOCRM_DATABASE_PORT=${{MySQL.MYSQLPORT}}
# ESPOCRM_DATABASE_NAME=${{MySQL.MYSQLDATABASE}}
# ESPOCRM_DATABASE_USER=${{MySQL.MYSQLUSER}}
# ESPOCRM_DATABASE_PASSWORD=${{MySQL.MYSQLPASSWORD}}
# Prefer a dedicated MySQL service named for staging, never production.

# --- Forbidden on staging (do not set) ---
# INSTANTLY_API_KEY=
# APOLLO_API_KEY=
# APIFY_TOKEN=
# SMTP_PASSWORD=
# BREVO_API_KEY=
# ESPOCRM_ALLOW_PRODUCTION=1
